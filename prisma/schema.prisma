generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  PDF
  TEXT
  WEBSITE
  YOUTUBE
  TRANSCRIPT
}

enum SourceStatus {
  QUEUED
  EXTRACTING
  EMBEDDING
  READY
  FAILED
}

model Notebook {
  id        String    @id @default(cuid())
  title     String    @default("Untitled notebook")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sources   Source[]
  messages  Message[]
}

model Source {
  id         String       @id @default(cuid())
  notebookId String
  notebook   Notebook     @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  type       SourceType
  title      String
  url        String?
  blobUrl    String?
  rawText    String?      @db.Text
  status     SourceStatus @default(QUEUED)
  error      String?
  chunkCount Int          @default(0)
  createdAt  DateTime     @default(now())

  @@index([notebookId])
}

model Message {
  id         String   @id @default(cuid())
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  role       String
  content    String   @db.Text
  citations  Json?
  createdAt  DateTime @default(now())

  @@index([notebookId])
}